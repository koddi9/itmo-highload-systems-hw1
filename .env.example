# cp .env.example .env - .env в .gitignore, настоящие секреты только там
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=yourPassword

# Доля искусственных 500ок и средняя дополнительная задержка в мс
FAILURE_RATE=0.02
LATENCY_MEAN_MS=20

# Нагрузка: суммарный RPS на оба инстанса и время разгона
LOAD_TARGET_RPS=40
LOAD_RAMP_UP=3m
